{
  "name": "aftertouch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A deterministic, manual-input educational contamination simulator with counterfactual replay.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
